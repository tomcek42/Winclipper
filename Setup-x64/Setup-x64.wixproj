<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputName>WinclipperSetup-x64</OutputName>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- Builds the EXE separately with msbuild; WiX only packages it. -->
    <DefineConstants>Winclipper.TargetPath=$(MSBuildThisFileDirectory)..\Winclipper\x64\Release\Winclipper.exe</DefineConstants>
    <!-- The project owner accepted the OSMF EULA (https://wixtoolset.org/osmf/). -->
    <AcceptEula>wix7</AcceptEula>
    <SuppressIces>ICE69</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.0" />
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
  </ItemGroup>
</Project>
